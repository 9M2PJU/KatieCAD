# -*- coding: utf-8 -*-
"""Generator for the basic symbol library (symbols/<category>/*.katieblock).

Run from the project root:   python tools/make_symbols.py

All symbols follow the same conventions as the hand-drawn fuse blocks:
  * vertical orientation, 5 mm pole pitch, pins at +-7.5 mm (2-pin symbols),
  * line weight 0.35 mm, pin radius 0.5 mm, text height 2 mm,
  * one electrical mask per device (main device or auxiliary device),
    anchored at its lower right corner and placed to the left of the symbol.
Edit the SYMBOLS section to add or change symbols, then run the script again.
"""
import math
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

from katiecad.model.core import (BlockDefinition, Linie, Kreis, Bogen, Rechteck,
                                 Polylinie, Text, Verbindungspunkt, ElektroMaske,
                                 Schraffur, vp_tags_eindeutig)
from katiecad.model.blocks import block_speichern, vorschlag_dateiname

OUT = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "symbols")
STYLE = dict(layer="0", farbe="#c29bff", linientyp="Volllinie (schmal)", eig_farbe=True)
DASH = dict(STYLE, linientyp="Strichlinie (verdeckt)")
W = 0.35


class Sym:
    """Collects the elements of one symbol."""

    def __init__(self, name, category, de):
        self.name, self.category, self.de = name, category, de
        self.el = []
        self.pin_names = []

    # --- geometry ------------------------------------------------
    def line(self, x1, y1, x2, y2, dash=False):
        self.el.append(Linie(x1, y1, x2, y2, staerke=W, **(DASH if dash else STYLE)))

    def poly(self, pts, closed=False, dash=False):
        self.el.append(Polylinie([tuple(p) for p in pts], geschlossen=closed,
                                 staerke=W, **(DASH if dash else STYLE)))

    def rect(self, x1, y1, x2, y2):
        self.el.append(Rechteck(x1, y1, x2, y2, staerke=W, **STYLE))

    def circle(self, cx, cy, r):
        self.el.append(Kreis(cx, cy, r, staerke=W, **STYLE))

    def arc(self, cx, cy, r, a1, a2):
        self.el.append(Bogen(cx, cy, r, a1, a2, staerke=W, **STYLE))

    def text(self, x, y, s, h=2.5, anchor="mitte_zentriert"):
        self.el.append(Text(x, y, s, h, 0.0, "Arial", anchor, staerke=None, **STYLE))

    def dot(self, x, y, r=0.8):
        pts = [(x + r * math.cos(math.radians(a)), y + r * math.sin(math.radians(a)))
               for a in range(0, 360, 30)]
        self.el.append(Schraffur(pts, muster="solid", staerke=None, **STYLE))

    def pin(self, x, y, name):
        n = len(self.pin_names) + 1
        self.pin_names.append(name)
        self.el.append(Verbindungspunkt(x, y, name, 2.0, 0.0, "Arial", None,
                                        tag="VP%d" % n, prompt="Pin %d" % n,
                                        wert=name, sichtbar=True, radius=0.5,
                                        staerke=0.25, **STYLE))

    def mask(self, x, y, rolle="haupt"):
        self.el.append(ElektroMaske(x, y, {"IND": "IND", "TYP": "TYP", "PER": "PER"},
                                    rolle=rolle, staerke=None, **STYLE))

    # --- output --------------------------------------------------
    def save(self):
        vp_tags_eindeutig(self.el)
        d = BlockDefinition(self.name, (0.0, 0.0), self.el)
        ordner = os.path.join(OUT, self.category)
        os.makedirs(ordner, exist_ok=True)
        block_speichern(os.path.join(ordner, vorschlag_dateiname(self.name)), d)
        return d


