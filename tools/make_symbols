def breaker(s, n):
    for i in range(n):
        x = 5.0 * i
        contact_pole(s, x, str(2 * i + 1), str(2 * i + 2))
        s.line(x - 1.0, 4.5, x + 1.0, 6.5); s.line(x - 1.0, 6.5, x + 1.0, 4.5)   # cross
    gang(s, 0, 5.0 * (n - 1))
    head(s, 0, "hand")

