def main():
    import shutil
    if os.path.isdir(OUT):                       # keep symbols/README.md
        for n in os.listdir(OUT):
            if os.path.isdir(os.path.join(OUT, n)):
                shutil.rmtree(os.path.join(OUT, n))
    names = set()
    for s in SYMBOLS:
        assert s.name not in names, s.name
        names.add(s.name)
        s.save()
    print(len(SYMBOLS), "symbols written to", OUT)
    return SYMBOLS


if __name__ == "__main__":
    main()

