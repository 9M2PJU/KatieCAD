def contact_pole(s, x, top, bot, nc=False):
    """One switching pole: pins at y = +-7.5, blade pivot at the bottom."""
    s.line(x, 7.5, x, 2.5)
    s.line(x, -7.5, x, -2.5)
    if nc:                                   # closed at rest: blade touches the tick
        s.line(x, -2.5, x + 2.0, 3.5)
        s.line(x, 2.5, x + 3.0, 2.5)
    else:
        s.line(x, -2.5, x - 2.5, 2.5)        # blade
    s.pin(x, 7.5, top)
    s.pin(x, -7.5, bot)


def gang(s, x_first, x_last):
    if x_last > x_first:
        s.line(x_first - 1.25, 0, x_last - 1.25, 0, dash=True)


def poles(s, n, names, nc=False):
    for i in range(n):
        contact_pole(s, 5.0 * i, names[2 * i], names[2 * i + 1], nc)
    gang(s, 0, 5.0 * (n - 1))


def head(s, xs, kind):
    """Actuator on the left of the first pole."""
    s.line(-1.25, 0, -5.0, 0, dash=True)
    if kind == "push":
        s.line(-5.0, -1.5, -5.0, 1.5)
    else:                                      # general hand operation
        s.line(-5.0, -1.5, -5.0, 1.5)
        s.line(-5.0, 1.5, -6.5, 1.5)
        s.line(-5.0, -1.5, -6.5, -1.5)


def fuse_pole(s, x, top, bot):
    s.line(x, 7.5, x, -7.5)
    s.rect(x - 1.5, 4.0, x + 1.5, -4.0)
    s.pin(x, 7.5, top)
    s.pin(x, -7.5, bot)


def mask_left(s, n_poles_width=0.0, rolle="haupt", y=-5.0, x=-3.5):
    s.mask(x, y, rolle)


def two_pin(s, top="1", bot="2"):
    s.pin(0, 7.5, top)
    s.pin(0, -7.5, bot)


